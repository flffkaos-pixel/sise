{
  "version": 2,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,detail.html,privacy.html,terms.html,contact.html,robots.txt,llms.txt,favicon.svg,og-image.svg}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
